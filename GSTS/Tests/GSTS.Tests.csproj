<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Automated checks for the business logic (Services) against a real MariaDB database.
    The service, data, model and helper files are compiled in directly, so the tests
    run the exact code the application uses, without the Windows Forms screens.
    Run from the GSTS folder:  dotnet run (project) Tests   - see README, Testing
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\GSTS\AppConfig.cs" Link="App\AppConfig.cs" />
    <Compile Include="..\GSTS\Data\*.cs" Link="App\Data\%(Filename)%(Extension)" />
    <Compile Include="..\GSTS\Models\*.cs" Link="App\Models\%(Filename)%(Extension)" />
    <Compile Include="..\GSTS\Services\*.cs" Link="App\Services\%(Filename)%(Extension)" />
    <Compile Include="..\GSTS\Helpers\PasswordHasher.cs" Link="App\Helpers\PasswordHasher.cs" />
    <Compile Include="..\GSTS\Helpers\Validator.cs" Link="App\Helpers\Validator.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
  </ItemGroup>

</Project>
